<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Adopted in TASK-011 alongside the REST wrapper, matching WebScraper's/job-applier's
         Spring Boot version. Its BOM now manages Jackson and JUnit versions consistently
         (the explicit jackson version pins and the standalone junit-bom import below were
         both removed - two separate, possibly-disagreeing version sources caused exactly this
         kind of runtime NoSuchMethodError in job-applier's TASK-008; letting one BOM own every
         jackson-*/junit-* artifact avoids repeating that. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.cvgenerator</groupId>
    <artifactId>cv-generator</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Use the latest stable version of Kotlin -->
        <kotlin.version>1.9.22</kotlin.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Kotlin Standard Library - THIS IS THE FIX for 'println' not found -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- For parsing YAML file into Kotlin objects. Versions now managed by
             spring-boot-starter-parent's BOM (was explicitly pinned to 2.15.2 before TASK-011). -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- For type-safe HTML generation in Kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-html-jvm</artifactId>
            <version>0.8.1</version>
        </dependency>

        <!-- Playwright for browser-grade HTML rendering and PDF printing -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.56.0</version>
        </dependency>

        <!-- REST wrapper (TASK-011) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Swagger UI / OpenAPI docs (CHORE-001). job-applier pins 2.6.0, but that version predates
             Spring Framework 6.2.x (bundled by spring-boot-starter-parent 3.5.3 here) and throws
             NoSuchMethodError on ControllerAdviceBean's constructor at the first request - confirmed
             by testing, not assumed. 2.8.6 is the latest 2.8.x release and is built against 6.2.x. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <!-- Kotlin Maven Plugin: Compiles .kt files -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven Surefire Plugin: needed explicitly for JUnit 5 test discovery -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Spring Boot Maven Plugin: repackages into an executable jar whose primary
                 behavior (as of TASK-011) is starting the REST server, not the Main.kt CLI -
                 replaces TASK-006's maven-shade-plugin, which doesn't merge Spring's
                 META-INF/spring/*.imports autoconfiguration files correctly across dependency
                 jars (a well-known shade+Spring Boot gotcha); the nested-jar format Boot's own
                 plugin produces is the standard, well-tested way to avoid that. Main.kt itself
                 is unaffected - still fully runnable via IDE or `java -cp <classpath> md.daniel_rosca.MainKt`. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- No <executions> block needed - spring-boot-starter-parent already binds a
                     default `repackage` execution to the `package` phase; declaring another one
                     here just ran it twice. -->
                <configuration>
                    <mainClass>md.daniel_rosca.web.CvGeneratorApplicationKt</mainClass>
                </configuration>
            </plugin>
            <!-- Kotlin linter/formatter, bound to `verify` -->
            <plugin>
                <groupId>com.github.gantsign.maven</groupId>
                <artifactId>ktlint-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>ktlint-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>